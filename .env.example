# Copy this file to .env and fill it with credentials for services you control.
# Never commit the resulting .env file.

# Supabase: use a project you own. The service-role key is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model providers
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
BEDROCK_REGION=
BEDROCK_CLAUDE_MODEL_ID=

# Optional integrations
TAVILY_API_KEY=
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Your own deployed Modal service URLs, if you enable image analysis.
SAM_SEGMENTATION_URL=
SAM3_SEGMENTATION_URL=
DEPTH_ESTIMATION_URL=

# Server configuration
PORT=8000
# Comma-separated browser origins. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Leave blank in normal deployments. If set, benchmark routes require this
# value in the X-Operations-Key header.
OPERATIONS_API_KEY=
